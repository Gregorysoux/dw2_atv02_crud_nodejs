<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Quentin Tarantino</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="conteudo">
    <h1>Quentin Tarantino</h1>
    <p>
      Site feito para o diretor Quentin Tarantino.
      Aqui dá pra ver alguns dos filmes dele, os atores que mais aparecem nos filmes e os
      gêneros que ele mais trabalha. Agora também dá pra cadastrar, editar e excluir cada um deles.
    </p>

    <div class="cards">
      <a class="card" href="/filmes"><strong><%= totais.filmes %></strong> filmes</a>
      <a class="card" href="/atores"><strong><%= totais.atores %></strong> atores</a>
      <a class="card" href="/generos"><strong><%= totais.generos %></strong> gêneros</a>
    </div>
  </div>

</body>
</html>
