<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title><%= tituloPagina %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="conteudo">
    <h1><%= tituloPagina %></h1>

    <% if (erro) { %>
      <p class="erro"><%= erro %></p>
    <% } %>

    <form class="formulario" method="POST" action="<%= acao %>">
      <label for="nome">Nome</label>
      <input type="text" id="nome" name="nome" value="<%= ator.nome %>" required>

      <label for="nacionalidade">Nacionalidade</label>
      <input type="text" id="nacionalidade" name="nacionalidade" value="<%= ator.nacionalidade %>">

      <label for="nascimento">Data de nascimento</label>
      <input type="date" id="nascimento" name="nascimento" value="<%= ator.nascimento %>">

      <div class="botoes">
        <button class="btn btn-novo" type="submit">Salvar</button>
        <a class="btn btn-cancelar" href="/atores">Cancelar</a>
      </div>
    </form>
  </div>

</body>
</html>
