<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Gêneros</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="conteudo">
    <h1>Gêneros</h1>
    <a class="btn btn-novo" href="/generos/novo">+ Novo gênero</a>

    <table>
      <tr>
        <th>Gênero</th>
        <th>Descrição</th>
        <th>Filmes</th>
        <th>Ações</th>
      </tr>
      <% generos.forEach(function(g) { %>
        <tr>
          <td><%= g.nome %></td>
          <td><%= g.descricao %></td>
          <td><%= g.total_filmes %></td>
          <td class="acoes">
            <a class="btn btn-editar" href="/generos/<%= g.id %>/editar">Editar</a>
            <form method="POST" action="/generos/<%= g.id %>/excluir" onsubmit="return confirm('Tem certeza que deseja excluir este gênero? Os filmes dele ficarão sem gênero.')">
              <button class="btn btn-excluir" type="submit">Excluir</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </table>
  </div>

</body>
</html>
